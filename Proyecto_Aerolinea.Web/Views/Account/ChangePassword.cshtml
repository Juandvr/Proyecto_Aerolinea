@model ChangaPasswordDTO

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cambiar contraseña</title>
    @await Html.PartialAsync("_Styles")
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Inter', sans-serif;
        }
        .card-change {
            max-width: 520px;
            margin: 80px auto;
            border-radius: 12px;
            box-shadow: 0 4px 30px rgba(0,0,0,0.08);
        }
        .form-control { border-radius: 8px; height:48px; }
        .btn-dark { background-color: #1c1b1b; border: none; }
        .btn-dark:hover { background-color: #000; }
    </style>
</head>
<body>
    <nav class="navbar bg-light border-bottom">
        <div class="container">
            <a class="navbar-brand fw-bold" href="#">Cambiar contraseña</a>
            <ul class="nav">
                <li class="nav-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            </ul>
        </div>
    </nav>

    <div class="card card-change p-4">
        <div class="card-body">
            <h4 class="fw-bold text-center mb-2">Actualiza tu contraseña</h4>
            <p class="text-muted text-center mb-3">Introduce tu contraseña actual y la nueva contraseña.</p>

            <form asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label class="form-label">Contraseña actual</label>
                    <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Contraseña actual" />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Nueva contraseña</label>
                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="Nueva contraseña (mín. 4 caracteres)" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirmar nueva contraseña</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Repite la nueva contraseña" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-dark w-100 rounded-pill py-2">Cambiar contraseña</button>
            </form>
        </div>
    </div>

    @await Html.PartialAsync("_Scripts")

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>